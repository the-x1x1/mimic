{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities: IPC commands, native dialogs, opener for folders/URLs, updater, process relaunch, asset protocol for cached previews.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/the-x1x1/mimic/**" },
        { "url": "https://github.com/the-x1x1/mimic" }
      ]
    },
    "updater:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
